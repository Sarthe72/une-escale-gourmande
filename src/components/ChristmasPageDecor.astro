---
interface Props { placement?: 'opening' | 'interlude'; page?: 'home' | 'chef' | 'chambre' | 'traiteur' | 'truffe' | 'contact'; motif?: 'candles' | 'fir'; }
const {placement='opening',page='home',motif='candles'}=Astro.props;
const candles=placement==='interlude'&&motif==='candles';
---
<div data-christmas-decor hidden aria-hidden="true" class:list={['christmas-page-decor',placement,`page-${page}`,{'with-candles':candles}]}>
 <img
   data-christmas-src={candles?'/fetes/noel-ivoire/bougies-640.webp':'/fetes/noel-ivoire/guirlande-1440.webp'}
   data-christmas-srcset={candles?'/fetes/noel-ivoire/bougies-320.webp 320w, /fetes/noel-ivoire/bougies-640.webp 640w':'/fetes/noel-ivoire/guirlande-720.webp 720w, /fetes/noel-ivoire/guirlande-1440.webp 1440w'}
   sizes={placement==='opening'?'100vw':candles?'(max-width: 600px) 160px, 240px':'(max-width: 600px) 280px, 420px'}
   width={candles?640:1440} height={candles?427:480} decoding="async" loading={placement==='opening'?'eager':'lazy'} alt=""
 />
</div>
<style>
 .christmas-page-decor{pointer-events:none;user-select:none}
 .christmas-page-decor[hidden]{display:none!important}
 .opening{position:absolute;inset:0 0 auto;z-index:2;height:230px;overflow:hidden;mask-image:linear-gradient(#000 0%,#000 65%,transparent 100%)}
 .opening img{display:block;width:100%;height:auto}
 .opening.page-chambre{height:210px}
 .opening.page-traiteur{height:185px}
 .opening.page-truffe{height:230px;filter:brightness(1.05)}
 .opening.page-chef{height:75px;mask-image:linear-gradient(#000,transparent)}
 .opening.page-contact{height:95px;mask-image:linear-gradient(#000 0%,#000 25%,transparent 100%)}
 .opening.page-contact img{mask-image:linear-gradient(to right,#000 0%,#000 16%,transparent 32%,transparent 68%,#000 84%,#000)}
 .interlude{position:relative;max-width:1000px;margin:0 auto;height:120px;display:block}
 .interlude:before,.interlude:after{content:'';position:absolute;top:60%;width:calc(50% - 145px);height:1px;background:linear-gradient(to right,transparent,#c8b78d)}
 .interlude:before{left:20px}.interlude:after{right:20px;transform:rotate(180deg)}
 .interlude img{position:absolute;width:420px;height:140px;object-fit:contain;left:50%;top:50%;transform:translate(-50%,-50%)}
 .interlude.with-candles{height:170px}
 .interlude.with-candles img{width:240px;height:160px}
 @media(min-width:1100px){.opening.page-home img{max-height:340px;object-fit:cover;object-position:center top}}
 @media(max-width:600px){.opening{height:150px}.opening img{width:150%;max-width:none;margin-left:-25%}.opening.page-chambre,.opening.page-truffe{height:145px}.opening.page-traiteur{height:130px}.opening.page-chef{height:55px}.opening.page-contact{height:70px}.interlude{height:85px}.interlude img{width:280px;height:94px}.interlude.with-candles{height:120px}.interlude.with-candles img{width:160px;height:110px}.interlude:before,.interlude:after{width:calc(50% - 105px)}}
</style>
