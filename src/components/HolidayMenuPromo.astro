<div id="holiday-menu-invitation" hidden>
 <a class="holiday-menu-banner" href="/menu-fetes/">
  <div><p>Noël &amp; Nouvel An · Le menu de Benjamin</p><h2>Un peu de magie,<br/><em>beaucoup de gourmandise.</em></h2></div>
  <span>Découvrir le menu des fêtes →</span>
 </a>
</div>
<style>
 #holiday-menu-invitation[hidden]{display:none}
 .holiday-menu-banner{position:absolute;bottom:25px;left:50%;transform:translateX(-50%);z-index:15;display:flex;justify-content:space-between;align-items:center;gap:24px;width:min(1000px,calc(100% - 48px));padding:24px 30px;background:linear-gradient(110deg,#fff9edfa,#eee3cefa);border:1px solid #d6b370a6;color:#234333;box-shadow:0 10px 35px #0003;text-decoration:none}
 .holiday-menu-banner p{font:10px system-ui;letter-spacing:.14em;text-transform:uppercase;color:#96743f;margin-bottom:8px}
 .holiday-menu-banner h2{font:30px/1.15 Georgia,serif}.holiday-menu-banner em{color:#95713b}
 .holiday-menu-banner span{padding:15px 20px;background:#2d5c45;color:#fff5df;font:11px system-ui;text-transform:uppercase;white-space:nowrap}
 :global(.holiday-home-hero.has-holiday-menu){min-height:780px;padding-bottom:170px}
 @media(max-width:620px){.holiday-menu-banner{display:block;text-align:center;padding:20px;width:calc(100% - 32px)}.holiday-menu-banner h2{font-size:26px;margin-bottom:20px}.holiday-menu-banner span{display:inline-block;font-size:10px}:global(.holiday-home-hero.has-holiday-menu){min-height:790px;padding-bottom:245px}:global(.holiday-home-hero.has-holiday-menu .holiday-home-copy>img){height:140px;margin-bottom:18px}}
</style>
<script>
 import {isChristmasSeason} from '../lib/christmasSeason';
 import {holidayCatalog} from '../lib/holidayCatalogClient';
 const preview=import.meta.env.DEV&&new URLSearchParams(location.search).get('preview')==='christmas';
 function updateHolidayMenuPromo(){
  const invitation=document.getElementById('holiday-menu-invitation');
  const hero=invitation?.closest('section');
  if(!preview&&!isChristmasSeason()){if(invitation)invitation.hidden=true;hero?.classList.remove('has-holiday-menu');return;}
  holidayCatalog().then(catalog=>{const visible=catalog.campaignVisible||preview;if(invitation)invitation.hidden=!visible;hero?.classList.toggle('has-holiday-menu',visible);}).catch(()=>{});
 }
 updateHolidayMenuPromo();
 document.addEventListener('seasonal-date-change',updateHolidayMenuPromo);
</script>
