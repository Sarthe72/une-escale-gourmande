---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "BedAndBreakfast",
  "name": "Une Escale Gourmande",
  "telephone": "+33625142608",
  "email": "jardinbenjamin@hotmail.fr",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1144 route des calvaires",
    "addressLocality": "Eyzerac",
    "postalCode": "24800",
    "addressCountry": "FR",
    "addressRegion": "Dordogne"
  },
  "url": "https://uneescalegourmande.fr/contact"
};
---

<Layout
  title="Contact & Réservation — Une Escale Gourmande à Eyzerac"
  description="Contactez Benjamin Jardin pour réserver la chambre d'hôte, un repas, un service traiteur ou le menu truffe. Eyzerac, Périgord Vert — 06 25 14 26 08."
  schema={schema}
>

  <!-- BANDEAU -->
  <section class="relative h-[22vh] min-h-[160px] max-h-[220px] flex items-center justify-center overflow-hidden">
    <img
      src="/images/campagne-perigord-vert-dordogne.webp"
      alt="Campagne Périgord Vert — Une Escale Gourmande Eyzerac"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 text-center text-white px-4">
      <p class="text-xs uppercase tracking-[0.3em] text-[#52b788] mb-2">Périgord Vert · Eyzerac</p>
      <h1 class="font-serif text-3xl md:text-4xl">Réserver ou renseigner</h1>
    </div>
  </section>

  <!-- CONTENU PRINCIPAL -->
  <section class="max-w-5xl mx-auto px-4 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

      <!-- COLONNE GAUCHE : COORDONNÉES -->
      <div class="space-y-6">

        <!-- Carte coordonnées -->
        <div class="bg-[#f5f0e6] border-l-4 border-[#2d6a4f] p-8">
          <h2 class="font-serif text-2xl text-[#1a1a1a] mb-7">Coordonnées</h2>
          <div class="space-y-6">

            <!-- Téléphone -->
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 bg-[#2d6a4f]/10 flex items-center justify-center flex-shrink-0 mt-0.5 rounded">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#2d6a4f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-widest text-stone-500 mb-1">Téléphone & WhatsApp</p>
                <a href="tel:+33625142608" class="font-serif text-xl text-[#2d6a4f] hover:underline block mb-3">06 25 14 26 08</a>
                <a
                  href="https://wa.me/33625142608?text=Bonjour%20Benjamin%2C%20je%20vous%20contacte%20depuis%20votre%20site%20Une%20Escale%20Gourmande."
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 bg-[#25D366] text-white px-4 py-2 text-sm font-medium hover:bg-[#1fba59] transition-colors rounded"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  Écrire sur WhatsApp
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 bg-[#2d6a4f]/10 flex items-center justify-center flex-shrink-0 mt-0.5 rounded">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#2d6a4f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-widest text-stone-500 mb-1">Email</p>
                <a href="mailto:jardinbenjamin@hotmail.fr" class="text-[#2d6a4f] hover:underline text-base">jardinbenjamin@hotmail.fr</a>
              </div>
            </div>

            <!-- Adresse -->
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 bg-[#2d6a4f]/10 flex items-center justify-center flex-shrink-0 mt-0.5 rounded">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#2d6a4f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-xs uppercase tracking-widest text-stone-500 mb-1">Adresse</p>
                <a href="https://www.google.com/maps/place/Une+escale+gourmande/@45.380983,0.91278,747m/data=!3m1!1e3!4m18!1m8!3m7!1s0x47ff161b59895929:0x32f45630c1414731!2s1144+Rte+des+Calvaires,+24800+Eyzerac!3b1!8m2!3d45.380983!4d0.91278!16s%2Fg%2F11smz8rvqh!3m8!1s0x47ff174140007a33:0xa0667f262c99b9ed!5m2!4m1!1i2!8m2!3d45.380983!4d0.91278!16s%2Fg%2F11xfjqpnjc?entry=ttu&g_ep=EgoyMDI2MDUyMC4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener" class="text-stone-700 hover:text-[#2d6a4f] transition-colors leading-relaxed">
                  1144 route des calvaires<br />24800 Eyzerac<br />Périgord Vert, Dordogne
                </a>
              </div>
            </div>

          </div>
        </div>

        <!-- Carte accès -->
        <div class="bg-white border border-stone-200 shadow-sm p-6">
          <h3 class="font-serif text-lg mb-4 flex items-center gap-3">
            <span class="w-0.5 h-5 bg-[#2d6a4f] inline-block flex-shrink-0"></span>
            Accès
          </h3>
          <ul class="space-y-2.5 text-sm text-stone-600">
            <li class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2d6a4f] flex-shrink-0"></span>
              À 8 km de Thiviers
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2d6a4f] flex-shrink-0"></span>
              À 35 km de Périgueux
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2d6a4f] flex-shrink-0"></span>
              À 45 km de Brive-la-Gaillarde
            </li>
          </ul>
        </div>

        <!-- Google Maps -->
        <div class="aspect-video w-full overflow-hidden shadow-md border border-stone-200">
          <iframe
            title="Localisation Une Escale Gourmande Eyzerac"
            src="https://maps.google.com/maps?q=Une+Escale+Gourmande+1144+Rte+des+Calvaires+24800+Eyzerac&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
          ></iframe>
        </div>

      </div>

      <!-- COLONNE DROITE : FORMULAIRE -->
      <div class="bg-white border border-stone-200 shadow-sm p-8 self-start">
        <h2 class="font-serif text-2xl text-[#1a1a1a] mb-2">Formulaire de contact</h2>
        <p class="text-stone-500 text-sm mb-7">Réponse sous 24h en général.</p>

        <div id="form-success" class="hidden bg-[#d1fae5] border border-[#2d6a4f] text-[#1b4332] px-6 py-8 text-center rounded">
          <div class="text-3xl mb-3">✓</div>
          <p class="font-serif text-xl mb-2">Message envoyé !</p>
          <p class="text-sm">Benjamin reviendra vers vous rapidement.</p>
        </div>

        <form class="space-y-5" id="contact-form">
          <input type="hidden" name="access_key" value="eb63057c-fdd6-4ea6-b838-d20017cb1f6b" />
          <input type="hidden" name="subject" value="Nouveau message — Une Escale Gourmande" />
          <input type="hidden" name="from_name" value="Une Escale Gourmande" />

          <div>
            <label for="nom" class="block text-xs uppercase tracking-widest text-stone-500 mb-1.5">Nom *</label>
            <input type="text" id="nom" name="nom" required class="w-full border border-stone-200 px-4 py-3 focus:outline-none focus:border-[#2d6a4f] bg-stone-50 focus:bg-white transition-colors text-sm" />
          </div>
          <div>
            <label for="email" class="block text-xs uppercase tracking-widest text-stone-500 mb-1.5">Email *</label>
            <input type="email" id="email" name="email" required class="w-full border border-stone-200 px-4 py-3 focus:outline-none focus:border-[#2d6a4f] bg-stone-50 focus:bg-white transition-colors text-sm" />
          </div>
          <div>
            <label for="telephone" class="block text-xs uppercase tracking-widest text-stone-500 mb-1.5">Téléphone</label>
            <input type="tel" id="telephone" name="telephone" class="w-full border border-stone-200 px-4 py-3 focus:outline-none focus:border-[#2d6a4f] bg-stone-50 focus:bg-white transition-colors text-sm" />
          </div>
          <div>
            <label for="sujet" class="block text-xs uppercase tracking-widest text-stone-500 mb-1.5">Sujet *</label>
            <select id="sujet" name="sujet" required class="w-full border border-stone-200 px-4 py-3 focus:outline-none focus:border-[#2d6a4f] bg-stone-50 focus:bg-white transition-colors text-sm">
              <option value="">Choisir...</option>
              <option value="chambre">Chambre d'hôte</option>
              <option value="traiteur">Traiteur / Chef à domicile</option>
              <option value="menu-truffe">Menu Truffe</option>
              <option value="autre">Autre</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-xs uppercase tracking-widest text-stone-500 mb-1.5">Message *</label>
            <textarea id="message" name="message" rows="5" required class="w-full border border-stone-200 px-4 py-3 focus:outline-none focus:border-[#2d6a4f] bg-stone-50 focus:bg-white transition-colors text-sm resize-none"></textarea>
          </div>
          <button type="submit" id="submit-btn" class="w-full bg-[#2d6a4f] text-white py-3.5 font-medium tracking-wide hover:bg-[#1b4332] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg text-sm uppercase">
            Envoyer le message
          </button>
          <p id="form-error" class="hidden text-red-600 text-sm text-center">Une erreur est survenue. Veuillez réessayer ou nous contacter directement par téléphone.</p>
        </form>

        <script>
          const form = document.getElementById('contact-form');
          const successBox = document.getElementById('form-success');
          const errorMsg = document.getElementById('form-error');
          const submitBtn = document.getElementById('submit-btn');

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            submitBtn.disabled = true;
            submitBtn.textContent = 'Envoi en cours…';
            errorMsg.classList.add('hidden');

            try {
              const res = await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                body: new FormData(form)
              });
              const data = await res.json();
              if (data.success) {
                form.classList.add('hidden');
                successBox.classList.remove('hidden');
              } else {
                throw new Error();
              }
            } catch {
              errorMsg.classList.remove('hidden');
              submitBtn.disabled = false;
              submitBtn.textContent = 'Envoyer le message';
            }
          });
        </script>
      </div>

    </div>
  </section>

</Layout>
