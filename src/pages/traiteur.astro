---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "FoodEstablishment",
  "name": "Traiteur & Chef à domicile — Une Escale Gourmande",
  "description": "Benjamin Jardin, chef traiteur et chef à domicile en Dordogne, Corrèze et Haute-Vienne. Mariages, baptêmes, repas d'entreprise, chef privé. Jusqu'à 120 personnes.",
  "url": "https://uneescalegourmande.fr/traiteur",
  "telephone": "+33625142608",
  "email": "jardinbenjamin@hotmail.fr",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1144 route des calvaires",
    "addressLocality": "Eyzerac",
    "postalCode": "24800",
    "addressCountry": "FR"
  },
  "areaServed": ["Dordogne", "Corrèze", "Haute-Vienne"],
  "servesCuisine": ["Française", "Gastronomique", "Bistronomie"]
};
---

<Layout
  title="Traiteur & Chef à domicile Dordogne — Périgord | Une Escale Gourmande"
  description="Benjamin Jardin, chef traiteur et chef à domicile. Mariages, baptêmes, repas d'entreprise en Dordogne, Corrèze et Haute-Vienne. Cuisine gourmande et locale jusqu'à 120 personnes."
  image="/images/traiteur-assiettes.jpg"
  schema={schema}
>
  <!-- HERO -->
  <section class="relative h-[65vh] min-h-[450px] flex items-end overflow-hidden">
    <img data-parallax src="/images/traiteur-assiettes.jpg" alt="Service traiteur gastronomique" class="absolute inset-0 w-full h-full object-cover object-top" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/65 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 pb-12 w-full">
      <p class="text-white/70 text-sm uppercase tracking-widest mb-2">Événements</p>
      <h1 class="font-serif text-4xl md:text-5xl text-white">Traiteur & Chef à domicile</h1>
      <p class="text-white/80 mt-2 text-lg font-light">Dordogne · Corrèze · Haute-Vienne</p>
    </div>
  </section>

  <!-- INTRO -->
  <section class="max-w-3xl mx-auto px-4 py-16 text-center">
    <h2 class="font-serif text-3xl mb-6">Une cuisine sur-mesure pour vos événements</h2>
    <p class="text-lg text-stone-600 leading-relaxed">
      Cuisinier de métier, Benjamin Jardin met son savoir-faire à votre service pour tous types d'événements. Une cuisine gourmande et inventive autour de produits locaux, en laissant une belle place au végétal et aux associations de saveurs originales.
    </p>
  </section>

  <!-- DEUX FORMULES -->
  <section class="bg-white py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Traiteur -->
        <div class="border border-stone-200 p-8">
          <h3 class="font-serif text-2xl mb-4 text-[#2d6a4f]">Traiteur</h3>
          <p class="text-stone-600 leading-relaxed mb-6">
            Benjamin prépare et livre vos repas, entièrement cuisinés avec des produits frais et locaux. Une solution clé en main pour vos événements, quel que soit le nombre de convives.
          </p>
          <ul class="space-y-2 text-stone-600 text-sm">
            <li class="flex items-start gap-2"><span class="text-[#2d6a4f] mt-1">✓</span> Buffets & cocktails dînatoires</li>
            <li class="flex items-start gap-2"><span class="text-[#2d6a4f] mt-1">✓</span> Repas assis servis</li>
            <li class="flex items-start gap-2"><span class="text-[#2d6a4f] mt-1">✓</span> Brunch & déjeuners</li>
            <li class="flex items-start gap-2"><span class="text-[#2d6a4f] mt-1">✓</span> Livraison et mise en place</li>
          </ul>
        </div>

        <!-- Chef à domicile -->
        <div class="border border-stone-200 p-8">
          <h3 class="font-serif text-2xl mb-4 text-[#3b6b8a]">Chef à domicile</h3>
          <p class="text-stone-600 leading-relaxed mb-6">
            Benjamin se déplace directement chez vous ou dans votre lieu de réception pour cuisiner en live. Une expérience immersive qui fait de votre cuisine le cœur de l'événement.
          </p>
          <ul class="space-y-2 text-stone-600 text-sm">
            <li class="flex items-start gap-2"><span class="text-[#3b6b8a] mt-1">✓</span> Repas en domaines & châteaux</li>
            <li class="flex items-start gap-2"><span class="text-[#3b6b8a] mt-1">✓</span> Dîners privés à domicile</li>
            <li class="flex items-start gap-2"><span class="text-[#3b6b8a] mt-1">✓</span> Menu truffe en saison</li>
            <li class="flex items-start gap-2"><span class="text-[#3b6b8a] mt-1">✓</span> Menu sur-mesure selon vos souhaits</li>
          </ul>
        </div>

        <!-- Cours de cuisine -->
        <div class="border border-stone-200 p-8">
          <h3 class="font-serif text-2xl mb-4 text-[#b87333]">Cours de cuisine</h3>
          <p class="text-stone-600 leading-relaxed mb-6">
            Benjamin partage son savoir-faire autour d'un atelier convivial. Une expérience ludique et gourmande, seul, en couple ou en groupe, à Eyzerac ou chez vous.
          </p>
          <ul class="space-y-2 text-stone-600 text-sm">
            <li class="flex items-start gap-2"><span class="text-[#b87333] mt-1">✓</span> Initiation & perfectionnement</li>
            <li class="flex items-start gap-2"><span class="text-[#b87333] mt-1">✓</span> Cuisine de saison & produits locaux</li>
            <li class="flex items-start gap-2"><span class="text-[#b87333] mt-1">✓</span> Sur-mesure selon votre niveau</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- OCCASIONS -->
  <section class="py-6 max-w-5xl mx-auto px-4">
    <p class="text-center text-sm font-medium text-stone-700 mb-4">Pour toutes vos occasions :</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 w-fit mx-auto">
      {[
        { icon: "💍", label: "Mariages" },
        { icon: "👶", label: "Baptêmes" },
        { icon: "🏢", label: "Repas d'entreprise" },
        { icon: "👨‍👩‍👧‍👦", label: "Repas de famille" },
        { icon: "🏰", label: "Domaines & châteaux" },
        { icon: "☀️", label: "Brunchs" },
        { icon: "🎉", label: "Anniversaires" },
        { icon: "🍂", label: "Menu truffe" },
      ].map(item => (
        <span class="bg-[#f5f0e6] px-4 py-2.5 text-sm text-stone-700 flex items-center justify-center gap-2 text-center">
          <span>{item.icon}</span>{item.label}
        </span>
      ))}
    </div>
  </section>

  <!-- ZONE + CAPACITÉ -->
  <section class="bg-[#ede7d8] py-16">
    <div class="max-w-4xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 text-center">
        <div>
          <div class="text-5xl font-serif text-[#2d6a4f] mb-3">120</div>
          <p class="font-medium text-stone-700 mb-2">personnes maximum</p>
          <p class="text-stone-500 text-sm">Benjamin s'adapte aussi bien aux petits dîners intimes qu'aux grandes réceptions.</p>
        </div>
        <div>
          <div class="text-3xl mb-3">📍</div>
          <p class="font-medium text-stone-700 mb-2">Zone d'intervention</p>
          <p class="text-stone-600 text-sm">Dans un rayon de <strong>40 km autour de Thiviers</strong></p>
          <p class="text-stone-500 text-sm mt-1">Dordogne · Corrèze · Haute-Vienne</p>
        </div>
      </div>
    </div>
  </section>

  <!-- IDÉES DE MENU -->
  <section class="bg-[#1a1a1a] text-white py-20">
    <div class="max-w-5xl mx-auto px-4">
      <p class="text-center text-sm uppercase tracking-widest text-stone-400 mb-3">Inspiration</p>
      <h2 class="font-serif text-3xl text-center mb-14">Quelques idées de menu</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

        <div>
          <h3 class="font-serif text-xl text-[#52b788] mb-6 pb-3 border-b border-white/10">Entrées</h3>
          <ul class="space-y-5 text-stone-300 text-sm leading-relaxed">
            <li>Asperges blanches, truite de Borèze en gravlax, pesto d'ail des ours et noix du Périgord</li>
            <li>Œuf mollet, crémeux de piperade, magret séché et copeaux d'Ossau-Iraty</li>
            <li>Tartare de tomates anciennes, crémeux de chèvre frais, coulis d'herbe du potager et crumble à la noisette</li>
          </ul>
        </div>

        <div>
          <h3 class="font-serif text-xl text-[#52b788] mb-6 pb-3 border-b border-white/10">Plats</h3>
          <ul class="space-y-5 text-stone-300 text-sm leading-relaxed">
            <li>Risotto d'épeautre au citron confit, pleurotes, chorizo et légumes du potager</li>
            <li>Pintade farcie façon basquaise, polenta snackée aux piquillos, caviar de courgettes et jus tomaté</li>
            <li>Merlu de ligne, crémeux d'aubergine au basilic, pommes de terre primeur et tapenade</li>
            <li>Paleron confit puis rôti, pressé de pommes de terre aux champignons, pulpe de carottes à la fève de tonka et jus réduit</li>
          </ul>
        </div>

        <div>
          <h3 class="font-serif text-xl text-[#52b788] mb-6 pb-3 border-b border-white/10">Desserts</h3>
          <ul class="space-y-5 text-stone-300 text-sm leading-relaxed">
            <li>Riz au lait de la ferme, fraises, noix caramélisée et sirop de rhubarbe</li>
            <li>Cheesecake citron, cœur fondant à la myrtille et sablé noisette</li>
            <li>Entremets chocolat, cœur caramel et sablé breton</li>
          </ul>
        </div>

      </div>
      <p class="text-center text-stone-500 text-xs mt-12">Liste non exhaustive</p>
    </div>
  </section>

  <!-- GALERIE -->
  <section class="py-16 max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <img src="/images/entree-oeuf-jambon.jpg" alt="Entrée gastronomique" class="w-full aspect-square object-cover" />
      <img src="/images/amuse-bouches.jpg" alt="Amuse-bouches traiteur" class="w-full aspect-square object-cover" />
      <img src="/images/risotto-champignons.webp" alt="Plat principal" class="w-full aspect-square object-cover" />
      <img src="/images/dessert-tarte-fruits.jpg" alt="Dessert de saison" class="w-full aspect-square object-cover" />
      <img src="/images/verrine-chocolat.webp" alt="Verrine au chocolat" class="w-full aspect-square object-cover" />
      <img src="/images/dessert-fraise.jpg" alt="Dessert aux fraises" class="w-full aspect-square object-cover" />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden py-24 text-center px-4">
    <img src="/images/traiteur-assiettes.jpg" class="absolute inset-0 w-full h-full object-cover object-top" alt="" aria-hidden="true" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <p class="text-[#52b788] text-sm uppercase tracking-widest mb-4">Devis gratuit</p>
      <h2 class="font-serif text-3xl md:text-4xl text-white mb-5">Un projet ? Parlons-en.</h2>
      <p class="text-white/70 mb-10 text-lg">Chaque événement est unique.<br />Benjamin établit un devis personnalisé selon vos besoins, votre lieu et votre budget.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+33625142608" class="inline-block bg-white text-[#1b4332] px-8 py-3 font-semibold hover:bg-[#f5f0e6] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          📞 06 25 14 26 08
        </a>
        <a href="https://wa.me/33625142608?text=Bonjour%20Benjamin%2C%20je%20vous%20contacte%20pour%20un%20projet%20traiteur." target="_blank" rel="noopener"
          class="inline-flex items-center justify-center bg-[#25D366] text-white px-5 py-3 hover:bg-[#1fba59] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href="/contact" class="inline-block border border-white/50 text-white px-8 py-3 hover:bg-white/10 transition-all hover:-translate-y-0.5 active:scale-95">
          Formulaire de contact
        </a>
      </div>
    </div>
  </section>
</Layout>
