---
interface Props { placement: 'logo' | 'header' | 'footer' }
const { placement } = Astro.props;
---
<div data-christmas-decor hidden aria-hidden="true" class:list={['christmas-decor', placement]}>
  {placement === 'logo' ? (
    <svg viewBox="0 0 60 40" width="36" height="24"><path fill="#c0a678" d="M8 30Q14 2 34 5Q47 7 51 24L43 24Q36 14 33 16L30 30Z"/><path fill="#fff9ee" d="M6 28Q18 24 34 28L35 35Q20 31 6 35Z"/><circle cx="51" cy="25" r="6" fill="#fff9ee"/></svg>
  ) : placement === 'header' ? (
    <svg viewBox="0 0 1200 22" preserveAspectRatio="none" width="1200" height="22">
      <path d="M0 2Q150 28 300 2Q450 28 600 2Q750 28 900 2Q1050 28 1200 2" fill="none" stroke="#365c45" stroke-width="2"/>
      <defs><radialGradient id="christmas-light-halo"><stop stop-color="#ffe4a0" stop-opacity=".85"/><stop offset="1" stop-color="#ffd178" stop-opacity="0"/></radialGradient></defs>
      {[75,225,375,525,675,825,975,1125].map((x) => <g><circle cx={x} cy="12" r="14" fill="url(#christmas-light-halo)"/><circle cx={x} cy="12" r="3" fill="#fff5d7"/></g>)}
    </svg>
  ) : (
    <img data-christmas-src="/fetes/noel-ivoire/bougies-320.webp" data-christmas-srcset="/fetes/noel-ivoire/bougies-320.webp 320w, /fetes/noel-ivoire/bougies-640.webp 640w" sizes="(max-width:767px) 130px, 190px" width="320" height="213" loading="lazy" decoding="async" alt=""/>
  )}
</div>
<style>
  .christmas-decor { pointer-events: none; user-select: none; }
  .christmas-decor[hidden] { display: none !important; }
  .logo { position: absolute; top: -7px; left: 9px; transform: rotate(-15deg); }
  .header { position: absolute; inset: 0 0 auto; height: 22px; overflow: hidden; }
  .header svg { width: 100%; height: 22px; display: block; }
  .footer { position: absolute; right: 24px; bottom: 14px; width:190px;opacity:.95; }
  .footer img{width:100%;height:auto}
  :global(html[data-christmas-season="on"] [data-christmas-decor][hidden]){display:block!important}
  @media (max-width: 767px) { .footer { right:auto;left:50%;transform:translateX(-50%);bottom:8px;width:130px } :global(html[data-christmas-season="on"] .site-footer){padding-bottom:105px} }
</style>
<script>
  import { isChristmasSeason } from '../lib/christmasSeason.js';
  function updateChristmasDecor() {
    // Preview is available locally only; production always follows the calendar.
    const preview = import.meta.env.DEV && new URLSearchParams(location.search).get('preview') === 'christmas';
    const active = preview || isChristmasSeason();
    document.documentElement.dataset.christmasSeason=active?'on':'off';
    document.querySelectorAll<HTMLElement>('[data-christmas-decor]').forEach(el => { el.hidden = !active; });
    if(active)document.querySelectorAll<HTMLImageElement>('img[data-christmas-src]').forEach(image=>{
      if(!image.getAttribute('src')){if(image.dataset.christmasSrcset)image.srcset=image.dataset.christmasSrcset;image.src=image.dataset.christmasSrc||'';}
    });
    if(preview)document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link=>{const url=new URL(link.href,location.href);if(url.origin===location.origin&&!url.pathname.startsWith('/api/')&&!link.getAttribute('href')?.startsWith('#')){url.searchParams.set('preview','christmas');link.href=url.href;}});
  }
  updateChristmasDecor();
  document.addEventListener('visibilitychange', updateChristmasDecor);
  document.addEventListener('seasonal-date-change', updateChristmasDecor);
</script>
