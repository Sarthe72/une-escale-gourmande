---
<a data-awareness-link hidden href={donationURL} target="_blank" rel="noopener noreferrer" class="awareness-link">
  <img data-awareness-image="octobre-rose" hidden src="/images/octobre-rose.png" width="26" height="34" alt="Octobre rose — Faire un don à la Ligue contre le cancer (nouvel onglet)" />
  <img data-awareness-image="movember" hidden src="/images/movember.png" width="76" height="43" alt="Movember — Faire un don à la Ligue contre le cancer (nouvel onglet)" />
</a>
<style>
  .awareness-link { flex: none; border-radius: 3px; }
  .awareness-link[hidden], img[hidden] { display: none !important; }
  .awareness-link:focus-visible { outline: 2px solid #2d6a4f; outline-offset: 4px; }
  img { object-fit: contain; mix-blend-mode: multiply; }
</style>
<script>
  import { awarenessCampaign } from '../lib/seasonalAwareness.js';
  function updateAwareness() {
    const campaign = awarenessCampaign();
    document.querySelectorAll<HTMLAnchorElement>('[data-awareness-link]').forEach(link => {
      link.hidden = !campaign;
      link.querySelectorAll<HTMLImageElement>('[data-awareness-image]').forEach(image => {
        image.hidden = image.dataset.awarenessImage !== campaign;
      });
    });
  }
  updateAwareness();
  // Also switch at midnight if the page stays open across a month boundary.
  setInterval(updateAwareness, 60_000);
  document.addEventListener('visibilitychange', updateAwareness);
</script>
