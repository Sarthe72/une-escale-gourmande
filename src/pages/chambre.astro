---
import Layout from '../layouts/Layout.astro';
import tarifs from '../data/tarifs-chambre.json';
import photosChambre from '../data/photos-chambre.json';
import photosDomaine from '../data/photos-domaine.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Chambre d'hôte — Une Escale Gourmande",
  "description": "Suite indépendante au cœur du Périgord Vert. Terrasse privée, douche à l'italienne, petit-déjeuner inclus. 66€ pour deux personnes.",
  "url": "https://uneescalegourmande.fr/chambre",
  "telephone": "+33625142608",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1144 route des calvaires",
    "addressLocality": "Eyzerac",
    "postalCode": "24800",
    "addressCountry": "FR"
  },
  "priceRange": "66€ / nuit pour 2 personnes",
  "amenityFeature": [
    {"@type": "LocationFeatureSpecification", "name": "Terrasse privée", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Douche à l'italienne", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Télévision HD", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Réfrigérateur", "value": true},
    {"@type": "LocationFeatureSpecification", "name": "Petit-déjeuner inclus", "value": true}
  ]
};
---

<Layout
  title="Chambre d'hôte Périgord Vert — Suite avec terrasse à Eyzerac | Une Escale Gourmande"
  description="Suite indépendante en Périgord Vert. Terrasse privée, douche à l'italienne, petit-déjeuner maison inclus. 66€ pour deux personnes. Dîner en option à 19€/personne."
  image="/images/chambre-hotes-eyzerac-suite-lit-ete.jpg"
  schema={schema}
>
  <!-- HERO -->
  <section class="relative h-[65vh] min-h-[450px] flex items-end overflow-hidden">
    <img data-parallax src="/images/chambre-hotes-eyzerac-perigord-vert-suite.jpg" alt="Chambre d'hôte Périgord Vert — suite indépendante Une Escale Gourmande Eyzerac" class="absolute inset-0 w-full h-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 pb-12 w-full">
      <p class="text-white/70 text-sm uppercase tracking-widest mb-2">Séjour</p>
      <h1 class="font-serif text-4xl md:text-5xl text-white">Chambre d'hôte</h1>
      <p class="text-white/80 mt-2 text-lg font-light">Suite indépendante · Périgord Vert</p>
    </div>
  </section>

  <!-- DESCRIPTION + TARIF -->
  <section class="max-w-5xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-serif text-2xl mb-6">Un havre de paix en pleine nature</h2>
        <div class="space-y-4 text-stone-700 leading-relaxed">
          <p>
            Suite indépendante au cœur du Périgord Vert, dans un écrin de verdure. Vous serez au calme, au milieu de la nature, avec une <strong>terrasse privée</strong> pour les beaux jours.
          </p>
          <p>
            La chambre dispose d'une <strong>grande douche à l'italienne</strong> et d'une salle d'eau avec toilettes indépendantes. Tout le confort est réuni pour un séjour ressourçant.
          </p>
          <p>
            Le <strong>petit-déjeuner maison</strong> est inclus dans le tarif — préparé avec soin par Benjamin, il donne le ton d'une journée gourmande.
          </p>
          <p>
            Sur demande, Benjamin peut vous préparer un <strong>dîner sur place</strong> (+19€/personne) : cuisine engagée, produits locaux, menu selon la saison.
          </p>
        </div>

        <!-- TARIF -->
        <div class="mt-10 bg-[#ede7d8] p-6 border-l-4 border-[#2d6a4f]">
          <h3 class="font-serif text-xl mb-4">Tarifs</h3>
          <div class="space-y-2 text-stone-700">
            <div class="flex justify-between items-center">
              <span>Chambre pour 2 personnes + petit-déjeuner</span>
              <span class="font-bold text-lg">{tarifs.prix_base} €</span>
            </div>
            <div class="flex justify-between items-center text-sm text-stone-500">
              <span>Haute saison (Juillet & août)</span>
              <span class="font-medium">{tarifs.prix_haute_saison} €</span>
            </div>
            <div class="flex justify-between items-center text-sm text-stone-500 mt-4 pt-4 border-t border-stone-200">
              <span>Dîner en option (par personne)</span>
              <span class="font-medium">+ {tarifs.prix_diner} €</span>
            </div>
          </div>
          <p class="text-xs text-stone-400 mt-4">Tarif par nuit · Petit-déjeuner inclus</p>
        </div>

        <a href="/contact" class="inline-block mt-8 bg-[#2d6a4f] text-white px-8 py-3 hover:bg-[#1b4332] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          Réserver
        </a>
      </div>

      <!-- PHOTOS -->
      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          {photosChambre.photos.map(photo => (
            <img src={photo.src} alt={photo.alt} class="w-full aspect-square object-cover" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ÉQUIPEMENTS -->
  <section class="bg-white py-8">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-serif text-xl text-center mb-5">Équipements</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {[
          { icon: "🌿", label: "Terrasse privée" },
          { icon: "🚿", label: "Douche à l'italienne" },
          { icon: "📺", label: "Télévision HD" },
          { icon: "🎲", label: "Jeux de société" },
          { icon: "❄️", label: "Réfrigérateur" },
          { icon: "🔁", label: "Micro-onde" },
          { icon: "☕", label: "Petit-déjeuner inclus" },
          { icon: "🍽️", label: "Dîner en option" },
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-[#f5f0e6] px-4 py-2 text-sm text-stone-700">
            <span>{item.icon}</span>{item.label}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- GALERIE EXTÉRIEUR -->
  <section class="py-16 max-w-5xl mx-auto px-4">
    <h2 class="font-serif text-2xl text-center mb-10">Le domaine</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {photosDomaine.photos.map((photo, i) => (
        <img src={photo.src} alt={photo.alt} class={`w-full aspect-[4/3] object-cover${i % 4 === 0 ? ' col-span-2 md:col-span-1' : ''}`} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden py-24 text-center px-4">
    <img src="/images/jardin-domaine-escale-gourmande-eyzerac.jpeg" class="absolute inset-0 w-full h-full object-cover" alt="" aria-hidden="true" />
    <div class="absolute inset-0 bg-black/58"></div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <p class="text-[#52b788] text-sm uppercase tracking-widest mb-4">Réservation</p>
      <h2 class="font-serif text-3xl md:text-4xl text-white mb-5">Envie d'une nuit au Périgord Vert ?</h2>
      <p class="text-white/70 mb-10 text-lg">Benjamin répond rapidement par mail ou WhatsApp.<br />Réservation aussi disponible sur Airbnb.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+33625142608" class="inline-block bg-white text-[#1b4332] px-8 py-3 font-semibold hover:bg-[#f5f0e6] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          📞 06 25 14 26 08
        </a>
        <a href="https://wa.me/33625142608?text=Bonjour%20Benjamin%2C%20je%20souhaite%20réserver%20la%20chambre%20d'hôte." target="_blank" rel="noopener"
          class="inline-flex items-center justify-center bg-[#25D366] text-white px-5 py-3 hover:bg-[#1fba59] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href="/contact" class="inline-block border border-white/50 text-white px-8 py-3 hover:bg-white/10 transition-all hover:-translate-y-0.5 active:scale-95">
          Formulaire de contact
        </a>
      </div>
    </div>
  </section>
</Layout>
