---
export const prerender = true;
---
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Commande des fêtes — aperçu</title></head><body>
<main><p>PARCOURS EN PRÉPARATION</p><h1>Votre table de fêtes</h1><p>Retrait à Saint-Jean-de-Côle. Paiement au retrait : chèque, espèces ou virement immédiat.</p><p id="state" role="status">Chargement…</p>
<form hidden><h2>Vos plats</h2><div id="dishes"></div><h2>Votre retrait</h2><label>Créneau<select name="pickup" required></select></label><h2>Vos coordonnées</h2><label>Nom<input name="name" autocomplete="family-name" required maxlength="100"/></label><label>Prénom<input name="firstName" autocomplete="given-name" required maxlength="100"/></label><label>Téléphone<input name="phone" type="tel" autocomplete="tel" required/></label><label>E-mail (facultatif)<input name="email" type="email" autocomplete="email"/></label><label>Paiement au retrait<select name="payment"><option value="cash">Espèces</option><option value="cheque">Chèque</option><option value="instant_transfer">Virement immédiat</option></select></label><p id="total"></p><label><input type="checkbox" required/> Je vérifie les plats, quantités et le créneau avant confirmation.</label><button>Confirmer ma commande</button><p>Vos coordonnées servent au suivi de cette commande. Pour une allergie, contactez Benjamin avant de commander au 06 25 14 26 08.</p></form></main>
<script>
const form = document.querySelector('form')!;
const state = document.querySelector('#state')!;
const money = (c:number) => (c/100).toLocaleString('fr-FR',{style:'currency',currency:'EUR'});
let key = crypto.randomUUID();
try {
 const response = await fetch('/api/holiday/catalog'); if (!response.ok) throw Error('Service indisponible.');
 const catalog = await response.json();
 if (!catalog.open) { state.textContent = 'Les commandes ne sont pas encore ouvertes.'; }
 else {
 form.hidden = false; state.textContent = 'Choisissez vos plats et votre retrait.';
 for (const dish of catalog.dishes) {
 const label = document.createElement('label'); label.textContent = dish.name + (dish.price === null ? ' · bientôt disponible' : ' · '+money(dish.price));
 const input = document.createElement('input'); input.type='number'; input.min='0'; input.max='100'; input.value='0'; input.dataset.id=dish.id; input.disabled=dish.price===null; input.setAttribute('aria-label','Quantité : '+dish.name); label.append(input); document.querySelector('#dishes')!.append(label);
 }
 for (const pickup of catalog.pickups) { const option=document.createElement('option'); option.value=pickup.id; option.textContent=pickup.label; form.querySelector('[name=pickup]')!.append(option); }
 const items = () => Array.from(form.querySelectorAll<HTMLInputElement>('[data-id]')).filter(i=>Number(i.value)>0).map(i=>({id:i.dataset.id,quantity:Number(i.value)}));
 form.addEventListener('input',()=>{document.querySelector('#total')!.textContent='Total : '+money(items().reduce((sum,i)=>sum+catalog.dishes.find((d:any)=>d.id===i.id).price*i.quantity,0));});
 form.addEventListener('submit',async event=>{event.preventDefault(); const button=form.querySelector('button')!;button.disabled=true;
 try { const body={...Object.fromEntries(new FormData(form)),items:items()}; const result=await fetch('/api/holiday/orders',{method:'POST',headers:{'Content-Type':'application/json','Idempotency-Key':key},body:JSON.stringify(body)});const data=await result.json();if(!result.ok)throw Error(data.error);form.hidden=true;state.textContent='Commande confirmée · Référence '+data.id+' · '+money(data.total)+'. Conservez cette référence. Paiement au retrait.'; }
 catch(error){state.textContent=error instanceof Error?error.message:'Connexion interrompue. Réessayez.';button.disabled=false;}
 });
 }
} catch { state.textContent='Service indisponible. Réessayez plus tard.'; }
</script>
<style>body{margin:0;background:#f7f0e2;color:#163c2c;font:17px system-ui}main{max-width:700px;margin:auto;padding:32px 20px}h1,h2{font-family:Georgia}label{display:block;margin:16px 0}input:not([type=checkbox]),select{display:block;box-sizing:border-box;width:100%;padding:12px;margin-top:8px;font:inherit;border:1px solid #b3b9ab;border-radius:8px}button{background:#23543e;color:white;padding:16px;border:0;border-radius:8px;font:inherit;cursor:pointer}button:disabled{opacity:.5}#state{padding:16px;background:#fff}form[hidden]{display:none}</style></body></html>
