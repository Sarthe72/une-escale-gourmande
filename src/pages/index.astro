---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "BedAndBreakfast",
  "name": "Une Escale Gourmande",
  "description": "Chambre d'hôte, traiteur et chef à domicile au cœur du Périgord Vert. Benjamin Jardin, cuisinier de métier depuis 20 ans.",
  "url": "https://uneescalegourmande.fr",
  "telephone": "+33625142608",
  "email": "jardinbenjamin@hotmail.fr",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1144 route des calvaires",
    "addressLocality": "Eyzerac",
    "postalCode": "24800",
    "addressCountry": "FR",
    "addressRegion": "Dordogne"
  },
  "image": "https://uneescalegourmande.fr/images/terrasse-petit-dejeuner-escale-gourmande-eyzerac.webp",
  "priceRange": "€€",
  "servesCuisine": ["Française", "Gastronomique", "Périgord"]
};
---

<Layout
  title="Une Escale Gourmande — Chambre d'hôte & Traiteur à Eyzerac, Périgord Vert"
  description="Benjamin Jardin vous accueille à Eyzerac en Périgord Vert. Chambre d'hôte avec petit-déjeuner, étape idéale sur la Flow Vélo. Traiteur, chef à domicile et menu truffe."
  schema={schema}
>
  <!-- HERO -->
  <section class="relative h-[90vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <img
      data-parallax
      src="/images/terrasse-petit-dejeuner-escale-gourmande-eyzerac.webp"
      alt="Terrasse Une Escale Gourmande, Périgord Vert — chambre d'hôte et traiteur Eyzerac"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/20"></div>
    <div class="relative z-10 text-center text-white px-4 max-w-3xl mx-auto">
      <img src="/images/logo.svg" alt="Une Escale Gourmande" class="h-52 md:h-72 w-auto mx-auto mb-6 invert drop-shadow-xl" />
      <h1 class="font-serif text-4xl md:text-6xl font-bold mb-4 leading-tight" style="text-shadow: 0 2px 12px rgba(0,0,0,0.7)">
        Une Escale Gourmande
      </h1>
      <p class="text-xl md:text-2xl font-light mb-2 tracking-wide" style="text-shadow: 0 1px 6px rgba(0,0,0,0.8)">Périgord Vert · Eyzerac</p>
      <p class="text-lg font-light mb-10 opacity-90" style="text-shadow: 0 1px 6px rgba(0,0,0,0.8)">Chambre d'hôte · Traiteur · Chef à domicile · Menu Truffe</p>
      <a href="/contact" class="inline-block bg-white text-[#1a1a1a] px-8 py-3 font-medium tracking-widest uppercase text-sm hover:bg-[#2d6a4f] hover:text-white transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
        Réserver
      </a>
    </div>
  </section>

  <!-- Bloc unifié avec un seul logo watermark -->
  <div class="relative overflow-hidden">
    <img src="/images/logo.svg" aria-hidden="true" class="absolute inset-0 w-full h-full object-contain opacity-[0.04] pointer-events-none select-none z-[1]" />

  <!-- INTRO -->
  <section class="relative py-20 text-center px-4">
    <div class="relative z-10 max-w-3xl mx-auto">
    <h2 class="font-serif text-3xl md:text-4xl text-[#1a1a1a] mb-6">Bienvenue dans notre écrin de verdure</h2>
    <p class="text-lg text-stone-600 leading-relaxed">
      Au cœur du Périgord Vert, <strong>Benjamin Jardin</strong>, cuisinier de métier depuis 20 ans, vous propose une halte gourmande au fil des saisons. Chambre d'hôte, dîners sur place, traiteur pour vos événements ou chef à domicile : chaque prestation est pensée autour de produits locaux soigneusement sélectionnés, du potager et de la truffière.
    </p>
    </div>
  </section>


  <!-- 3 ACTIVITÉS -->
  <section class="relative bg-white py-4">
    <div class="relative z-10 max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
        <a href="/chambre" class="group relative overflow-hidden" style="aspect-ratio:4/5">
          <img src="/images/chambre-hotes-eyzerac-suite-lit-ete.webp" alt="Chambre d'hôte Périgord Vert — suite indépendante à Eyzerac" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/50 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="font-serif text-2xl mb-2">Chambre d'hôte</h3>
            <p class="text-sm opacity-90 font-light">Suite indépendante avec terrasse privée</p>
            <span class="inline-block mt-2 text-xs bg-white/20 px-2 py-0.5 rounded-sm">🚴 Étape Flow Vélo</span>
            <span class="inline-block mt-2 text-xs tracking-widest uppercase border-b border-white pb-0.5">Découvrir →</span>
          </div>
        </a>
        <a href="/traiteur" class="group relative overflow-hidden" style="aspect-ratio:4/5">
          <img src="/images/traiteur-chef-domicile-dordogne-assiettes.webp" alt="Traiteur gastronomique Dordogne — chef à domicile Benjamin Jardin" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-black/45 group-hover:bg-black/55 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="font-serif text-2xl mb-2">Traiteur & Chef à domicile</h3>
            <p class="text-sm opacity-90 font-light">Mariages, baptêmes, repas d'entreprise...</p>
            <span class="inline-block mt-3 text-xs tracking-widest uppercase border-b border-white pb-0.5">Découvrir →</span>
          </div>
        </a>
        <a href="/menu-truffe" class="group relative overflow-hidden" style="aspect-ratio:4/5">
          <img src="/images/truffe-noire-melanosporum-fraiche-perigord.webp" alt="Menu truffe noire melanosporum Périgord — Eyzerac Dordogne" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/50 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <h3 class="font-serif text-2xl mb-2">Menu Truffe</h3>
            <p class="text-sm opacity-90 font-light">Décembre à février · Truffière personnelle</p>
            <span class="inline-block mt-3 text-xs tracking-widest uppercase border-b border-white pb-0.5">Découvrir →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- GALERIE PLATS -->
  <section class="relative overflow-hidden py-20 px-4">
    <div class="relative z-10 max-w-6xl mx-auto">
    <h2 class="font-serif text-3xl text-center mb-12">Une cuisine gourmande et engagée</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <img src="/images/dessert-myrtille-traiteur-gastronomique-perigord.webp" alt="Dessert myrtille — traiteur gastronomique Périgord" class="w-full aspect-square object-cover" />
      <img src="/images/entree-gastronomique-traiteur-chef-domicile-dordogne.webp" alt="Entrée gastronomique — chef à domicile Dordogne" class="w-full aspect-square object-cover" />
      <img src="/images/dessert-tarte-fruits-traiteur-dordogne.webp" alt="Tarte aux fruits de saison — traiteur Dordogne Benjamin Jardin" class="w-full aspect-square object-cover" />
      <img src="/images/amuse-bouches-traiteur-mariage-dordogne.webp" alt="Amuse-bouches traiteur mariage Dordogne" class="w-full aspect-square object-cover" />
    </div>
    </div>
  </section>

  <!-- MÉDIAS -->
  <section class="relative overflow-hidden bg-[#ede7d8] py-16">
    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
      <p class="text-sm uppercase tracking-widest text-stone-500 mb-10">Ils parlent de nous</p>
      <div class="flex flex-col sm:flex-row items-stretch justify-center gap-6">
        <a href="https://www.ici.fr/emissions/l-art-de-vivre-en-perigord/a-eyzerac-une-table-d-hotes-celebre-la-truffe-avec-creativite-et-passion-4440710" target="_blank" rel="noopener"
          class="flex flex-col items-center gap-4 bg-white px-8 py-6 shadow-sm hover:shadow-md transition-shadow w-full sm:w-64">
          <img src="/images/logo-ici.webp" alt="ICI - Radio France" class="h-10 w-32 object-contain" />
          <span class="text-stone-600 text-sm">L'Art de Vivre en Périgord</span>
          <span class="text-xs text-[#2d6a4f] font-medium mt-auto">Écouter →</span>
        </a>
        <a href="https://www.france.tv/france-3/nouvelle-aquitaine/le-gout-des-rencontres-nouvelle-aquitaine/7490948-etonnant-dessert-au-chocolat-en-dordogne.html" target="_blank" rel="noopener"
          class="flex flex-col items-center gap-4 bg-white px-8 py-6 shadow-sm hover:shadow-md transition-shadow w-full sm:w-64">
          <img src="/images/logo-francetv.webp" alt="France TV" class="h-10 w-32 object-contain" />
          <span class="text-stone-600 text-sm">Le Goût des Rencontres</span>
          <span class="text-xs text-[#2d6a4f] font-medium mt-auto">Voir le reportage →</span>
        </a>
        <a href="https://www.google.com/travel/hotels/entity/CgsI7fPm5OLkn7OgARAB/reviews" target="_blank" rel="noopener"
          class="flex flex-col items-center gap-4 bg-white px-8 py-6 shadow-sm hover:shadow-md transition-shadow w-full sm:w-64">
          <svg class="h-10 w-10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <div class="text-center">
            <p class="text-stone-600 text-sm">Avis Google</p>
            <p class="text-yellow-400 mt-1">★★★★★ <span class="text-stone-500 text-xs">5,0 · 9 avis</span></p>
          </div>
          <span class="text-xs text-[#2d6a4f] font-medium mt-auto">Voir les avis →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PRODUCTEURS PARTENAIRES -->
  <section class="relative bg-white py-10 px-4">
    <div class="relative z-10 max-w-5xl mx-auto">
      <h2 class="font-serif text-3xl text-center text-[#1a1a1a] mb-6">Nos Producteurs & Partenaires</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {[
          { produit: "Lait & miel", nom: "GAEC Bosloubet", lieu: "Eyzerac", href: "https://www.perigord-limousin-tourisme.com/inspirez-vous-de-nos-idees/nos-coups-de-coeur/la-ferme-de-marie-pierre/gaec-ferme-de-bosloubet-chantegros_DEGAQU024FS0001U/", logo: "logo-partenaire-gaec-bosloubet.webp" },
          { produit: "Champignons de carrière", nom: "La ferme de la Béloffie", lieu: "Saint-Pierre-de-Côle", href: "https://www.instagram.com/champiloffie/", href2: "https://www.facebook.com/profile.php?id=61566345376129", label2: "Facebook", logo: "logo-partenaire-ferme-beloffie.webp" },
          { produit: "Pain au fournil", nom: "Fournil du Cantou", lieu: "Saint-Martin-de-Fressengeas", href: "https://www.facebook.com/p/Le-Cant%C3%B3u-Fournil-de-Saint-Martin-61555133223276/", logo: "logo-partenaire-fournil-cantou.webp" },
          { produit: "Beurre & fromages", nom: "Ferme de la Pinsonnie", lieu: "Coulaures", href: "https://www.facebook.com/profile.php?id=61556608415579", logo: "logo-partenaire-ferme-pinsonnie.webp" },
          { produit: "Légumes de saison", nom: "Le Potager de la Vergne", lieu: "Périgord Vert", href: "https://www.lepotagerdelavergne.fr/", href2: "https://www.facebook.com/lepotagerdelavergne", label2: "Facebook", logo: "logo-partenaire-potager-vergne.webp" },
          { produit: "Légumes", nom: "Jardins du Petit Clos", lieu: "Saint-Paul-la-Roche", href: "https://www.facebook.com/p/GAEC-Jardins-Du-Petit-Clos-100085062189835/", logo: "logo-partenaire-jardins-petit-clos.webp" },
          { produit: "Viande", nom: "Boucherie Goursat", lieu: "Excideuil", href: "https://maps.app.goo.gl/z5QJQccYTFbXxNKh6", logo: null },
          { produit: "Canard du Périgord", nom: "Fermette des Planchettes", lieu: "Clermont-d'Excideuil", href: "https://www.la-plate-forme.fr/boutiques/319-fermette-des-planchettes", logo: "logo-partenaire-ferme-planchettes.webp" },
          { produit: "Jus de pommes maison", nom: "Domaine familial", lieu: "Périgord Vert", href: null, logo: null },
        ].map(({ produit, nom, lieu, href, href2, label2, logo }: { produit: string, nom: string, lieu: string, href: string | null, href2?: string, label2?: string, logo: string | null }) => (
          <div
            class="border border-stone-100 rounded-lg p-6 hover:border-[#2d6a4f]/30 hover:shadow-sm transition-colors relative overflow-hidden cursor-pointer"
            style={logo ? `background-image: url('/images/${logo}'); background-size: 55%; background-repeat: no-repeat; background-position: center;` : undefined}
          >
            {logo && <div class="absolute inset-0 bg-white/85 rounded-lg" />}
            {href && <a href={href} target="_blank" rel="noopener" class="absolute inset-0 z-10" aria-label={nom} />}
            <div class="relative z-20">
              <p class="text-xs uppercase tracking-widest text-[#2d6a4f] mb-2">{produit}</p>
              <p class="font-serif text-lg text-[#1a1a1a] mb-1">{nom}</p>
              <p class="text-stone-400 text-xs mb-4">{lieu}</p>
              {!href && <span class="text-xs text-stone-300 italic">Production familiale</span>}
              {href2 && (
                <a href={href2} target="_blank" rel="noopener" class="relative z-30 text-xs text-stone-500 hover:text-[#2d6a4f] transition-colors inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  {label2}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Location Le Mans centrée -->
      <div class="mt-5 flex justify-center">
        <div
          class="border border-stone-100 rounded-lg p-6 hover:border-[#2d6a4f]/30 hover:shadow-sm transition-colors relative overflow-hidden cursor-pointer w-full sm:max-w-xs text-center"
          style="background-image: url('/images/logo-partenaire-appartement-le-mans.webp'); background-size: 55%; background-repeat: no-repeat; background-position: center;"
        >
          <div class="absolute inset-0 bg-white/85 rounded-lg" />
          <a href="https://lemansgare.github.io/locationlemansgare/" target="_blank" rel="noopener" class="absolute inset-0 z-10" aria-label="Location appartement Le Mans" />
          <div class="relative z-20">
            <p class="text-xs uppercase tracking-widest text-[#2d6a4f] mb-2">Location saisonnière</p>
            <p class="font-serif text-lg text-[#1a1a1a] mb-1">Appartement Le Mans</p>
            <p class="text-stone-400 text-xs">Circuit des 24h du Mans · Sarthe</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  </div><!-- fin bloc logo unique -->

  <!-- CTA -->
  <section class="relative overflow-hidden py-24 text-center px-4">
    <img src="/images/terrasse-petit-dejeuner-escale-gourmande-eyzerac.webp" class="absolute inset-0 w-full h-full object-cover" alt="" aria-hidden="true" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <p class="text-[#52b788] text-sm uppercase tracking-widest mb-4">Contact</p>
      <h2 class="font-serif text-3xl md:text-4xl text-white mb-5">Une question ? Une réservation ?</h2>
      <p class="text-white/70 mb-10 text-lg">Benjamin répond rapidement par téléphone ou WhatsApp.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+33625142608" class="inline-block bg-white text-[#1b4332] px-8 py-3 font-semibold hover:bg-[#f5f0e6] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          📞 06 25 14 26 08
        </a>
        <a href="https://wa.me/33625142608?text=Bonjour%20Benjamin%2C%20je%20vous%20contacte%20depuis%20votre%20site%20Une%20Escale%20Gourmande." target="_blank" rel="noopener"
          class="inline-flex items-center justify-center bg-[#25D366] text-white px-5 py-3 hover:bg-[#1fba59] transition-all hover:-translate-y-0.5 active:scale-95 hover:shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href="/contact" class="inline-block border border-white/50 text-white px-8 py-3 hover:bg-white/10 transition-all hover:-translate-y-0.5 active:scale-95">
          Contactez-nous
        </a>
      </div>
    </div>
  </section>
</Layout>
