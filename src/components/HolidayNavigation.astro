---
const {class:linkClass=''}=Astro.props;
---
<li data-holiday-navigation hidden><a href="/menu-fetes/" class={linkClass}>Menu des fêtes</a></li>
<script>
 import {holidayCatalog} from '../lib/holidayCatalogClient';
 const preview=import.meta.env.DEV&&new URLSearchParams(location.search).get('preview')==='christmas';
 holidayCatalog().then(catalog=>{if(catalog.campaignVisible||preview)document.querySelectorAll<HTMLElement>('[data-holiday-navigation]').forEach(link=>{link.hidden=false;});}).catch(()=>{});
</script>
